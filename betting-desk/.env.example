# The Odds API — https://the-odds-api.com  (free tier: 500 credits/month)
ODDS_API_KEY=

# Books you can actually place a bet at. Odds API keys, comma separated.
# Hard Rock is not in the feed; FanDuel and DraftKings are.
YOUR_BOOKS=fanduel,draftkings

# A sharp book to anchor fair value against. Leave blank if your plan
# doesn't carry one — the code falls back to a consensus of the soft books.
# The Odds API does not carry Pinnacle; SportsGameOdds does.
SHARP_BOOK=

# power | multiplicative | additive
DEVIG_METHOD=power

DEFAULT_STAKE=10

# Seconds to cache an odds response. Lower = fresher lines, more credits.
CACHE_TTL=120

# Player props and other per-event markets cost one credit per market per
# game. Live calls to them are refused until this is 1. Demo mode ignores it.
ENABLE_PROPS=0
# Most markets one props call may ask for.
PROPS_MAX_MARKETS=5

DEMO_MODE=0

# Line movement: every live refresh writes price changes to a local SQLite
# file (data/history.sqlite3 unless HISTORY_DB says otherwise). 0 turns it off.
RECORD_HISTORY=1
HISTORY_DB=

# Adaptive model (see README: Adaptive model).
# equal | sharp. sharp weights the consensus by measured book sharpness.
FAIR_WEIGHTING=equal
SHARP_MIN_EVENTS=20
SHARP_MIN_BOOK_EVENTS=5
SHARP_PRIOR_EVENTS=20
# Thresholds you adopt via PUT /api/thresholds/... (default data/thresholds.json)
THRESHOLDS_FILE=
# 1 = the board uses adopted thresholds without ?edge_profile=adopted
APPLY_ADOPTED_THRESHOLDS=0
