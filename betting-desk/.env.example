# The Odds API — https://the-odds-api.com  (free tier: 500 credits/month)
ODDS_API_KEY=

# Books you can actually place a bet at. Odds API keys, comma separated.
# Hard Rock is not in the feed; FanDuel and DraftKings are.
YOUR_BOOKS=fanduel,draftkings

# A sharp book to anchor fair value against. Leave blank if your plan
# doesn't carry one — the code falls back to a consensus of the soft books.
# The Odds API does not carry Pinnacle; SportsGameOdds does.
SHARP_BOOK=

# power | multiplicative | additive
DEVIG_METHOD=power

DEFAULT_STAKE=10

# Seconds to cache an odds response. Lower = fresher lines, more credits.
CACHE_TTL=120

# Player props and other per-event markets cost one credit per market per
# game. Live calls to them are refused until this is 1. Demo mode ignores it.
ENABLE_PROPS=0
# Most markets one props call may ask for.
PROPS_MAX_MARKETS=5

DEMO_MODE=0

# Line movement: every live refresh writes price changes to a local SQLite
# file (data/history.sqlite3 unless HISTORY_DB says otherwise). 0 turns it off.
RECORD_HISTORY=1
HISTORY_DB=

# ---- Auto-refresh (off by default: it spends credits on its own) ----
# A background thread snapshots the board for these leagues, more often as
# the next game gets close, and stops for the day at a hard credit budget.
AUTO_REFRESH=0
AUTO_REFRESH_LEAGUES=mlb
# Hard cap per UTC day. 500 credits/month is ~16/day; a 3-market board is 3.
AUTO_REFRESH_DAILY_CREDITS=15
# Stop when The Odds API says this many credits or fewer are left this month,
# so manual refreshes still work at the end of the month.
AUTO_REFRESH_RESERVE=100
# "more than <time to next start> = every <minutes>", furthest first.
AUTO_REFRESH_CADENCE=24h=360,6h=120,2h=45,30m=15,0=10
# Runs more than FAR_HOURS before the next game may use only FAR_SHARE of the
# day's budget; the rest is kept for the hours before games.
AUTO_REFRESH_FAR_HOURS=3
AUTO_REFRESH_FAR_SHARE=0.5
# Until a game is this close, runs leave one run's worth of budget for the
# snapshot right before the start (the closing line).
AUTO_REFRESH_CLOSE_MINUTES=30
AUTO_REFRESH_HORIZON_DAYS=7
AUTO_REFRESH_MARKETS=h2h,spreads,totals
# SCHEDULER_STATE=data/scheduler.json

# ---- Alerts (defaults; change them in the Alerts tab) ----
ALERTS=1
# EV per dollar at which a play alerts (0.03 = 3%)
ALERT_MIN_EDGE=0.03
# Fair-probability move between two boards that counts as sharp (0.03 = 3 points)
ALERT_MOVE_PROB=0.03
# Spread/total main-line move that counts as sharp
ALERT_MOVE_POINTS=1
# ALERTS_FILE=data/alerts.json

# ---- Deployed instances ----
# Shared password. Blank = open (fine on 127.0.0.1, never on a public URL).
# The browser asks once; any username works.
DESK_PASSWORD=
