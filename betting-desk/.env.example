# Copy to .env and edit. Real environment variables override these.
#   cp .env.example .env && echo "DEMO_MODE=1" >> .env && ./run.sh

# --- feed -------------------------------------------------------------
# DEMO_MODE=1 pins the desk to the built-in fixtures: no network, no key,
# identical numbers every run. It overrides FEED_SOURCE.
DEMO_MODE=1

# demo | file | oddsapi   (ignored while DEMO_MODE=1)
FEED_SOURCE=demo

# FEED_SOURCE=file reads a JSON snapshot in the normalised shape.
# Relative paths resolve against the project root. See desk/feed.py.
FEED_FILE=

# FEED_SOURCE=oddsapi. Unverified in this build - see README.
ODDS_API_KEY=
ODDS_API_BASE=https://api.the-odds-api.com/v4

# --- server -----------------------------------------------------------
# No auth. Keep this on loopback.
HOST=127.0.0.1
PORT=8787

# --- desk -------------------------------------------------------------
# Books you can actually place a bet at, comma separated.
YOUR_BOOKS=fanduel,draftkings

# The fairness benchmark. Its de-vigged line is treated as the true price.
# Must NOT appear in YOUR_BOOKS - a book cannot grade its own number.
# Leave empty to always use a consensus of the other books instead.
SHARP_BOOK=pinnacle

# power | multiplicative | additive
# power handles lopsided markets best; additive can drive a longshot
# below zero probability. See desk/odds.py.
DEVIG_METHOD=power

# --- staking ----------------------------------------------------------
DEFAULT_STAKE=100
BANKROLL=2000

# Fraction of full Kelly to stake. Full Kelly (1.0) is only correct if
# your probability estimate is exactly right. 0.25 is the common choice.
KELLY_MULTIPLIER=0.25

# Hide rows below this EV per dollar. 0 shows only +EV; -1 shows everything.
MIN_EV=0
