<Project Sdk="Microsoft.NET.Sdk">
  <!-- Engine-free tests for the Visuals pure layer (Assets/Scripts/Visuals/Pure):
       SDF rasterization, art compositions, decor scatter rules, camera framing,
       path geometry and the digit font. Run: dotnet test Tools/VisualsTests -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0649;CS0169</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Visuals/Pure/**/*.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
  </ItemGroup>
</Project>
