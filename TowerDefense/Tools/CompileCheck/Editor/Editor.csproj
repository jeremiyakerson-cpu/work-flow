<Project Sdk="Microsoft.NET.Sdk">
  <!-- Type-checks Assets/**/Editor/** scripts against the UnityEditor stubs. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Assembly-CSharp-Editor</AssemblyName>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);UNITY_EDITOR;UNITY_6000_0_OR_NEWER;UNITY_IOS</DefineConstants>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414;CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/**/Editor/**/*.cs" />
    <ProjectReference Include="../Runtime/Runtime.csproj" />
    <ProjectReference Include="../../UnityStubs/Editor/UnityEditorStubs.csproj" />
  </ItemGroup>
</Project>
